# Environment Configuration
ENV=development
DEBUG=True

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Model Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cuda
BATCH_SIZE=32
TOP_K=100

# Index Settings
INDEX_TYPE=faiss
INDEX_PATH=data/indices

# Data Settings
DATA_PATH=data/movies
MOVIEDB_PATH=data/moviedb

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/recommender_db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/api.log

# LLM Settings (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Performance
CACHE_SIZE=10000
CACHE_TTL=3600

# Security
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1
